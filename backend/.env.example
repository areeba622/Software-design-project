# Copy this file to backend/.env and fill in your own values.
# backend/.env is git-ignored, so your password never gets committed.

DB_URL=jdbc:postgresql://localhost:5432/palette
DB_USERNAME=postgres
DB_PASSWORD=change-me

# Secret used to sign login tokens. At least 32 characters; generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Optional
# PORT=8081
# SHOW_SQL=false
# CORS_ALLOWED_ORIGINS=http://localhost:5173
